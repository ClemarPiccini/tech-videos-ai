# Copie para .env e preencha. NUNCA coloque chaves reais neste arquivo (ele vai para o git).

# Tudo aqui também pode ser configurado pela tela ⚙ Configurações da interface.

# IA do roteiro: auto (Claude se houver chave, senão local) | anthropic | ollama
LLM_PROVIDER=auto
# Modelo local do Ollama (grátis, roda no seu computador: https://ollama.com/download)
OLLAMA_MODEL=qwen2.5:7b

# Opcional: Claude (melhor qualidade, pago por uso)
ANTHROPIC_API_KEY=

# Recomendado: vídeos stock grátis (crie a chave em https://pixabay.com/api/docs/)
# Sem nenhuma chave de mídia, o app usa fotos em domínio público do Openverse.
PIXABAY_API_KEY=

# Opcional: só se você já tiver uma chave do Pexels
PEXELS_API_KEY=

# Opcional: narração premium
ELEVENLABS_API_KEY=
